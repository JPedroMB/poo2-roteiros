<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <!-- Alvos de log com nomenclatura personalizada e layouts customizados -->
    <target name="ArquivoLog" xsi:type="File" fileName="diario_execucao.log"
            layout="${longdate} [${level:uppercase=true}] - ${message} ${exception:format=tostring}" />
            
    <target name="VisualizacaoConsole" xsi:type="Console"
            layout="${longdate} [${level:uppercase=true}] - ${message}" />
  </targets>

  <rules>
    <!-- Rota de log direcionando para os targets personalizados -->
    <logger name="*" minlevel="Info" writeTo="ArquivoLog,VisualizacaoConsole" />
  </rules>
</nlog>